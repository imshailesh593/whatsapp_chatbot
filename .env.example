PORT=3000
HOST=0.0.0.0

# Postgres (docker-compose overrides this for the app container)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mns_bot?schema=public"

# Gemini (free-form question fallback). Without a key the bot still works, with static replies.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# WhatsApp linked-device login is stored here (QR scan once). Persist this folder/volume!
WA_SESSION_PATH=".wa_auth"

# Set to enable https://<host>/qr?token=<ADMIN_TOKEN> for scanning the QR on a headless server
ADMIN_TOKEN=""

TOPMATE_URL="https://topmate.io/mnsinstitute/"
