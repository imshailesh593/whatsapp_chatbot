PORT=3000
HOST=0.0.0.0

# Postgres (docker-compose overrides this for the app container)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mns_bot?schema=public"

# Gemini (free-form question fallback). Without a key the bot still works, with static replies.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# WhatsApp linked-device login is stored here (QR scan once). Persist this folder/volume!
WA_SESSION_PATH=".wa_auth"

# Only used for the WhatsApp QR link page: https://<host>/qr?token=<ADMIN_TOKEN>
ADMIN_TOKEN=""
# Signs dashboard login cookies (falls back to ADMIN_TOKEN). Use a long random string.
SESSION_SECRET=""
# Optional first-run admin (only created when no admin exists yet). Or run: node dist/cli/adminUser.js <email> <password>
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

TOPMATE_URL="https://topmate.io/mnsinstitute/"
