PORT=3000
HOST=0.0.0.0

# Postgres (docker-compose overrides this for the app container)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mns_bot?schema=public"

# Gemini (free-form question fallback). Without a key the bot still works, with static replies.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# WhatsApp linked-device login is stored here (QR scan once). Persist this folder/volume!
WA_SESSION_PATH=".wa_auth"

# Only used for the WhatsApp QR link page: https://<host>/qr?token=<ADMIN_TOKEN>
ADMIN_TOKEN=""
# Signs dashboard login cookies (falls back to ADMIN_TOKEN). Use a long random string.
SESSION_SECRET=""
# Optional first-run admin (only created when no admin exists yet). Or run: node dist/cli/adminUser.js <email> <password>
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

TOPMATE_URL="https://topmate.io/mnsinstitute/"

# --- Platform ---
# Name shown on the sign-in screen
PRODUCT_NAME="Lead Console"
# Set to 0 to disable public self-service sign-up (accounts then only via the admin CLI / platform admin)
SIGNUP_ENABLED=1

# --- Seed values for the default workspace (only used the first time, for data that existed before multi-tenancy) ---
BUSINESS_NAME="Your Business"
BUSINESS_TAGLINE=""
BUSINESS_DESCRIPTION=""
# WELCOME_INTRO=""
# FORM_URL=""
# TOPMATE_URL=""

# --- Billing (leave empty to run without online payments; the operator can still grant plans from the All businesses tab) ---
# Public base URL used in checkout return links (default: derived from the request)
# PUBLIC_URL=https://chatbot.example.com
# Stripe: create 3 recurring Prices (USD) and a webhook endpoint https://<host>/webhooks/stripe
# (events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Razorpay: create 3 monthly Plans (INR) and a webhook https://<host>/webhooks/razorpay
# (events: subscription.activated/charged/halted/pending/cancelled/completed/resumed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# --- Lead alerts by email (optional; WhatsApp alerts need no setup) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
