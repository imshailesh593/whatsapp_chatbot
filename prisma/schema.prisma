datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SessionStage {
  WELCOME
  /// Only for workspaces that ask for the customer's language first
  AWAITING_LANGUAGE
  AWAITING_SERVICE_SELECTION
  IN_QUESTIONNAIRE
  COMPLETED
  AGENT_TAKEOVER
}

/// One client business (tenant). Everything customer-facing is configured here.
model Workspace {
  id                     String    @id @default(uuid())
  slug                   String    @unique
  name                   String
  industry               String    @default("generic")
  businessName           String    @default("Your Business") @map("business_name")
  tagline                String    @default("")
  description            String    @default("")
  welcomeIntro           String    @default("") @map("welcome_intro")
  formUrl                String    @default("") @map("form_url")
  bookingUrl             String    @default("") @map("booking_url")
  bookingLabel           String    @default("one-to-one consultation") @map("booking_label")
  bookingNote            String    @default("") @map("booking_note")
  tone                   String    @default("friendly")
  knowledge              String    @default("")
  languages              String    @default("English")
  timezone               String    @default("UTC")
  notifyEmail            String    @default("") @map("notify_email")
  notifyPhone            String    @default("") @map("notify_phone")
  /// Free-form answers from the onboarding wizard (kept for reference / future AI drafting)
  onboarding             Json      @default("{}")
  onboardingCompleted    Boolean   @default(false) @map("onboarding_completed")
  /// False until the owner presses "Go live"; a paused workspace never auto-replies
  botEnabled             Boolean   @default(true) @map("bot_enabled")
  handoffEnabled         Boolean   @default(true) @map("handoff_enabled")
  handoffMessage         String    @default("") @map("handoff_message")
  /// Ask the customer's preferred language before showing the menu; later bot messages are translated into it
  languageStep           Boolean   @default(false) @map("language_step")
  /// The first message when languageStep is on (it asks which language the customer prefers)
  languageWelcome        String    @default("") @map("language_welcome")
  /// Automatic nudges to customers who go quiet (1, 3, 6 and 48 hours after their last message)
  followUpsEnabled       Boolean   @default(false) @map("follow_ups_enabled")
  /// Short code in this business referral link
  referralCode           String?   @unique @map("referral_code")
  /// Workspace that referred this one (plain text so deleting a referrer does not touch the referred)
  referredById           String?   @map("referred_by_id")
  payoutDetails          String    @default("") @map("payout_details")
  /// trial | starter | growth | scale | internal (unlimited, for the operator's own business)
  plan                   String    @default("trial")
  /// trialing | active | past_due | canceled
  planStatus             String    @default("trialing") @map("plan_status")
  trialEndsAt            DateTime? @map("trial_ends_at")
  currentPeriodEnd       DateTime? @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  billingProvider        String?   @map("billing_provider")
  providerCustomerId     String?   @map("provider_customer_id")
  providerSubscriptionId String?   @map("provider_subscription_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  services          Service[]
  sessions          Session[]
  leads             Lead[]
  logs              WebhookLog[]
  adminUsers        AdminUser[]
  usage             Usage[]
  stages            Stage[]
  broadcasts        Broadcast[]
  webhooks          Webhook[]
  apiKeys           ApiKey[]
  payments          Payment[]
  calendar          CalendarConfig?
  appointments      Appointment[]
  commissions       AffiliateCommission[]
  couponRedemptions CouponRedemption[]

  @@map("saas_workspaces")
}

/// A menu option ("Coaching", "Book a viewing", ...) with its own question list.
model Service {
  id             String     @id @default(uuid())
  workspaceId    String     @map("workspace_id")
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key            String
  title          String
  keywords       String[]   @default([])
  position       Int
  /// Shown instead of the generic thank-you when a customer finishes this service's questions (links, next step)
  closingMessage String     @default("") @map("closing_message")
  questions      Question[]

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("saas_services")
}

model Question {
  id        String  @id @default(uuid())
  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  key       String
  prompt    String
  position  Int

  @@index([serviceId, position])
  @@map("saas_questions")
}

model Session {
  id                String       @id @default(uuid())
  workspaceId       String       @map("workspace_id")
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber       String       @map("phone_number")
  contactName       String?      @map("contact_name")
  stage             SessionStage @default(WELCOME)
  /// Service.key within the workspace
  selectedService   String?      @map("selected_service")
  currentStep       Int          @default(0) @map("current_step")
  answers           Json         @default("{}")
  isAgentPaused     Boolean      @default(false) @map("is_agent_paused")
  /// Set when the customer asked for a person: the bot stepped back and the team was alerted
  handoffAt         DateTime?    @map("handoff_at")
  handoffSummary    String       @default("") @map("handoff_summary")
  /// Language the customer chose (workspaces with languageStep)
  language          String?
  /// Follow-up nudges sent since the customer's last message; reset when they reply
  followUpCount     Int          @default(0) @map("follow_up_count")
  lastFollowUpAt    DateTime?    @map("last_follow_up_at")
  /// Appointment times currently offered to the customer (ISO strings) while they choose one
  slotOffer         Json?        @map("slot_offer")
  /// Customer replied STOP: never include in broadcasts
  optedOut          Boolean      @default(false) @map("opted_out")
  /// Campaign tag from a click-to-chat link ("(ref: summer24)" in the first message)
  source            String?
  lastInteractionAt DateTime     @default(now()) @map("last_interaction_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  lead              Lead?

  @@unique([workspaceId, phoneNumber])
  @@index([stage])
  @@map("mns_sessions")
}

model Lead {
  id               String      @id @default(uuid())
  workspaceId      String      @map("workspace_id")
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId        String      @unique @map("session_id")
  session          Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events           LeadEvent[]
  phoneNumber      String      @map("phone_number")
  serviceCategory  String      @map("service_category")
  collectedData    Json        @map("collected_data")
  /// Pipeline stage (Stage.key within the workspace)
  stageKey         String      @default("new") @map("stage_key")
  /// Team member responsible for this lead (AdminUser.id)
  ownerId          String?     @map("owner_id")
  tags             String[]    @default([])
  followUpAt       DateTime?   @map("follow_up_at")
  followUpNotified Boolean     @default(false) @map("follow_up_notified")
  counsellorNotes  String?     @map("counsellor_notes")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([workspaceId, phoneNumber])
  @@index([workspaceId, stageKey])
  @@index([workspaceId, ownerId])
  @@index([followUpAt])
  @@index([serviceCategory])
  @@map("mns_leads")
}

model WebhookLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber String?   @map("phone_number")
  direction   String // INBOUND or OUTBOUND
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, phoneNumber, createdAt])
  @@map("mns_webhook_logs")
}

model AdminUser {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String    @map("password_hash")
  /// owner | admin | agent
  role         String    @default("owner")
  /// Platform operator: can list and open every workspace
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("mns_admin_users")
}

/// Monthly counters used for plan limits (period = YYYY-MM)
model Usage {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  period        String
  conversations Int       @default(0)
  aiReplies     Int       @default(0)
  broadcasts    Int       @default(0)

  @@unique([workspaceId, period])
  @@map("saas_usage")
}

model Payment {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String    @unique @map("provider_ref")
  plan        String
  /// Smallest currency unit (paise / cents)
  amount      Int
  currency    String
  status      String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("saas_payments")
}

/// Provider webhook ids already processed (idempotency)
model BillingEvent {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("saas_billing_events")
}

/// A step in the business's lead pipeline. "new" and "booked" are system stages the bot relies on.
model Stage {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  label       String
  color       String    @default("slate")
  position    Int
  /// open | won | lost
  kind        String    @default("open")

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("saas_stages")
}

/// A one-to-many message to customers who already chatted with the business
model Broadcast {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  text        String
  filters     Json      @default("{}")
  /// draft | scheduled | sending | paused | done | canceled
  status      String    @default("draft")
  note        String    @default("")
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  createdBy   String    @default("")
  scheduledAt DateTime? @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipients BroadcastRecipient[]

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("saas_broadcasts")
}

model BroadcastRecipient {
  id          String    @id @default(uuid())
  broadcastId String    @map("broadcast_id")
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  phone       String
  name        String?
  /// pending | sent | failed | skipped
  status      String    @default("pending")
  error       String    @default("")
  sentAt      DateTime? @map("sent_at")

  @@index([broadcastId, status])
  @@map("saas_broadcast_recipients")
}

/// Outgoing webhook: Zapier, Make, n8n, a Google Apps Script, the customer's own server
model Webhook {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      String[]
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("saas_webhooks")
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  webhookId     String   @map("webhook_id")
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  /// pending | ok | failed
  status        String   @default("pending")
  attempts      Int      @default(0)
  responseCode  Int?     @map("response_code")
  error         String   @default("")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("saas_webhook_deliveries")
}

/// API key for the public REST API. Only a hash is stored; the key is shown once on creation.
model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  hash        String    @unique
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("saas_api_keys")
}

/// Activity timeline of a lead
model LeadEvent {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspaceId String   @map("workspace_id")
  /// created | stage | owner | tags | follow_up | note
  type        String
  detail      String   @default("")
  actor       String   @default("bot")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("saas_lead_events")
}

/// Platform-operator actions (creating / deleting businesses, plan changes, impersonation)
model AuditLog {
  id          String   @id @default(uuid())
  actor       String
  action      String
  workspaceId String?  @map("workspace_id")
  detail      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("saas_audit_log")
}

/// Platform-wide switches (key -> JSON value)
model Setting {
  key   String @id
  value Json

  @@map("saas_settings")
}

/// Redeem code: gives a business a plan (or a longer trial) for N days without a payment
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  plan           String
  days           Int
  maxRedemptions Int?      @map("max_redemptions")
  redeemedCount  Int       @default(0) @map("redeemed_count")
  expiresAt      DateTime? @map("expires_at")
  active         Boolean   @default(true)
  note           String    @default("")
  createdBy      String    @default("") @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  redemptions CouponRedemption[]

  @@map("saas_coupons")
}

model CouponRedemption {
  id          String    @id @default(uuid())
  couponId    String    @map("coupon_id")
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([couponId, workspaceId])
  @@map("saas_coupon_redemptions")
}

/// Commission owed to a referring business when a business it referred pays (pending -> approved -> paid, or void)
model AffiliateCommission {
  id           String    @id @default(uuid())
  affiliateId  String    @map("affiliate_id")
  affiliate    Workspace @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredId   String    @map("referred_id")
  referredName String    @default("") @map("referred_name")
  paymentId    String    @unique @map("payment_id")
  /// Smallest currency unit
  amount       Int
  currency     String
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at")
  paidAt       DateTime? @map("paid_at")

  @@index([affiliateId, status])
  @@index([referredId])
  @@map("saas_affiliate_commissions")
}

/// A business's linked Google Calendar and its booking rules
model CalendarConfig {
  workspaceId   String    @id @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Encrypted with the server secret
  refreshToken  String    @map("refresh_token")
  googleEmail   String    @default("") @map("google_email")
  calendarId    String    @default("primary") @map("calendar_id")
  slotMinutes   Int       @default(30) @map("slot_minutes")
  bufferMinutes Int       @default(0) @map("buffer_minutes")
  /// ISO weekdays, 1 = Monday ... 7 = Sunday
  workDays      String    @default("1,2,3,4,5") @map("work_days")
  workStart     String    @default("09:00") @map("work_start")
  workEnd       String    @default("18:00") @map("work_end")
  noticeHours   Int       @default(4) @map("notice_hours")
  daysAhead     Int       @default(14) @map("days_ahead")
  reminderHours Int       @default(2) @map("reminder_hours")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("saas_calendar_configs")
}

model Appointment {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber   String    @map("phone_number")
  name          String?
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime  @map("ends_at")
  googleEventId String?   @map("google_event_id")
  /// confirmed | canceled
  status        String    @default("confirmed")
  reminderSent  Boolean   @default(false) @map("reminder_sent")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, startsAt])
  @@index([status, startsAt])
  @@map("saas_appointments")
}
