datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SessionStage {
  WELCOME
  AWAITING_SERVICE_SELECTION
  IN_QUESTIONNAIRE
  COMPLETED
  AGENT_TAKEOVER
}

/// One client business (tenant). Everything customer-facing is configured here.
model Workspace {
  id                  String   @id @default(uuid())
  slug                String   @unique
  name                String
  industry            String   @default("generic")
  businessName        String   @default("Your Business") @map("business_name")
  tagline             String   @default("")
  description         String   @default("")
  welcomeIntro        String   @default("") @map("welcome_intro")
  formUrl             String   @default("") @map("form_url")
  bookingUrl          String   @default("") @map("booking_url")
  bookingLabel        String   @default("one-to-one consultation") @map("booking_label")
  bookingNote         String   @default("") @map("booking_note")
  tone                String   @default("friendly")
  knowledge           String   @default("")
  languages           String   @default("English")
  timezone            String   @default("UTC")
  notifyEmail         String   @default("") @map("notify_email")
  notifyPhone         String   @default("") @map("notify_phone")
  /// Free-form answers from the onboarding wizard (kept for reference / future AI drafting)
  onboarding          Json     @default("{}")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  /// False until the owner presses "Go live"; a paused workspace never auto-replies
  botEnabled          Boolean  @default(true) @map("bot_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  services   Service[]
  sessions   Session[]
  leads      Lead[]
  logs       WebhookLog[]
  adminUsers AdminUser[]

  @@map("saas_workspaces")
}

/// A menu option ("Coaching", "Book a viewing", ...) with its own question list.
model Service {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  title       String
  keywords    String[]   @default([])
  position    Int
  questions   Question[]

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("saas_services")
}

model Question {
  id        String  @id @default(uuid())
  serviceId String  @map("service_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  key       String
  prompt    String
  position  Int

  @@index([serviceId, position])
  @@map("saas_questions")
}

model Session {
  id                String       @id @default(uuid())
  workspaceId       String       @map("workspace_id")
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber       String       @map("phone_number")
  contactName       String?      @map("contact_name")
  stage             SessionStage @default(WELCOME)
  /// Service.key within the workspace
  selectedService   String?      @map("selected_service")
  currentStep       Int          @default(0) @map("current_step")
  answers           Json         @default("{}")
  isAgentPaused     Boolean      @default(false) @map("is_agent_paused")
  lastInteractionAt DateTime     @default(now()) @map("last_interaction_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  lead              Lead?

  @@unique([workspaceId, phoneNumber])
  @@index([stage])
  @@map("mns_sessions")
}

model Lead {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId       String    @unique @map("session_id")
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phoneNumber     String    @map("phone_number")
  serviceCategory String    @map("service_category")
  collectedData   Json      @map("collected_data")
  isBookedTopmate Boolean   @default(false) @map("is_booked_topmate")
  followUp        Boolean   @default(false) @map("follow_up")
  counsellorNotes String?   @map("counsellor_notes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, phoneNumber])
  @@index([serviceCategory])
  @@map("mns_leads")
}

model WebhookLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber String?   @map("phone_number")
  direction   String // INBOUND or OUTBOUND
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, phoneNumber, createdAt])
  @@map("mns_webhook_logs")
}

model AdminUser {
  id           String     @id @default(uuid())
  workspaceId  String     @map("workspace_id")
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String     @unique
  passwordHash String     @map("password_hash")
  /// owner | admin | agent
  role         String     @default("owner")
  /// Platform operator: can list and open every workspace
  isSuperAdmin Boolean    @default(false) @map("is_super_admin")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastLoginAt  DateTime?  @map("last_login_at")

  @@map("mns_admin_users")
}
