{
  "name": "whatsapp-lead-bot",
  "version": "1.0.0",
  "description": "WhatsApp lead-qualification bot with admin console (Fastify, Prisma, Baileys, Gemini)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "build:web": "npm --prefix web ci && npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@google/genai": "^2.31.0",
    "@prisma/client": "^6.2.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^6.2.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
