{
  "name": "mns-whatsapp-bot",
  "version": "1.0.0",
  "description": "WhatsApp Bot for MNS Institute using Fastify and Prisma",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
